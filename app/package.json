{
  "name": "tender",
  "private": true,
  "version": "0.7.1",
  "type": "module",
  "scripts": {
    "tokens": "python ../replica/design/build_tokens.py ../replica/design/tokens.json src/renderer/src/styles",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "dev:design": "vite --port 5174",
    "build:renderer": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test:unit": "node scripts/unit.mjs",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win nsis portable --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --publish never"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.6",
    "@fontsource/jetbrains-mono": "5.2.6",
    "@kubernetes/client-node": "2.0.1",
    "@radix-ui/react-checkbox": "1.3.2",
    "@radix-ui/react-dialog": "1.1.14",
    "@radix-ui/react-dropdown-menu": "2.1.15",
    "@radix-ui/react-popover": "1.1.14",
    "@radix-ui/react-select": "2.2.5",
    "@radix-ui/react-switch": "1.2.5",
    "@radix-ui/react-tabs": "1.1.12",
    "@radix-ui/react-toast": "1.2.14",
    "@radix-ui/react-tooltip": "1.2.7",
    "@tanstack/react-query": "5.80.7",
    "@tanstack/react-table": "8.21.3",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "dockerode": "5.0.1",
    "electron-updater": "6.8.11",
    "lucide-react": "0.515.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "uplot": "1.6.32",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.1.10",
    "@types/dockerode": "4.0.2",
    "@types/node": "22.20.5",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.5.2",
    "electron": "44.10.2",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "tailwindcss": "4.1.10",
    "typescript": "5.8.3",
    "vite": "6.4.5",
    "vitest": "3.2.4"
  },
  "main": "out/main/index.js",
  "description": "A small desktop GUI for the Docker Engine you already run.",
  "author": "jluispbraga",
  "license": "MIT",
  "homepage": "https://github.com/jluispbraga/Harbor",
  "build": {
    "appId": "io.github.jluispbraga.tender",
    "productName": "Tender",
    "copyright": "Copyright © 2026 jluispbraga",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**",
      "resources/**",
      "package.json",
      "!resources/installer.nsh"
    ],
    "asarUnpack": [
      "resources/**"
    ],
    "win": {
      "icon": "resources/icon.png",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-${version}-${arch}-${target}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "linux": {
      "icon": "resources/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "synopsis": "A desktop app for the Docker Engine you already run",
      "maintainer": "jluispbraga <66488939+jluispbraga@users.noreply.github.com>",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "${name}_${version}_${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jluispbraga",
        "repo": "Tender",
        "releaseType": "release"
      }
    ]
  }
}
