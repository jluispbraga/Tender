# Harbor needs no keys or accounts. All variables are optional.

# Engine to connect to. Unset: the current Docker context, then //./pipe/docker_engine.
# Same meaning as for the docker CLI.
DOCKER_HOST=
DOCKER_CONTEXT=
DOCKER_TLS_VERIFY=
DOCKER_CERT_PATH=

# Where the local SQLite file lives. Unset: %APPDATA%\harbor\harbor.db
HARBOR_DB_PATH=

# Development only (ignored in packaged builds): run a script against window.harbor and quit.
HARBOR_SMOKE=
HARBOR_SHOTS=
HARBOR_SHOT_ROUTES=
