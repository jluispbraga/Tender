# Tender needs no keys or accounts. All variables are optional.

# Engine to connect to. Unset: the current Docker context, then //./pipe/docker_engine.
# Same meaning as for the docker CLI.
DOCKER_HOST=
DOCKER_CONTEXT=
DOCKER_TLS_VERIFY=
DOCKER_CERT_PATH=

# Where the local SQLite file lives. Unset: %APPDATA%\tender\tender.db
TENDER_DB_PATH=

# Development only (ignored in packaged builds): run a script against window.tender and quit.
TENDER_SMOKE=
TENDER_SHOTS=
TENDER_SHOT_ROUTES=
